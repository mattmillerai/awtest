// REFERENCE IMPLEMENTATION: CertificateManager (ACM)
// This is an annotated copy of cmd/awtest/services/certificatemanager/calls.go
// showing how each section of the template maps to a real service
// (aws-sdk-go-v2).
//
// This file uses .reference extension so it is NOT compiled by Go.

// TEMPLATE: package SERVICENAME
// Here: "certificatemanager" (lowercase, no underscores)
package certificatemanager

// CONCURRENT SAFETY: This service is concurrency-unaware by design.
// The worker pool (worker_pool.go) executes services concurrently at --speed=fast/insane.
// The safeScan wrapper handles panic recovery and error classification automatically.
// DO NOT import "sync", "sync/atomic", or spawn goroutines in this file.
// DO NOT use global mutable state. Each CallV2 invocation must be self-contained.

import (
	"context"
	"fmt"
	"time"

	// TEMPLATE: aws.ToString & friends, and the aws.Config type of CallV2
	"github.com/aws/aws-sdk-go-v2/aws"

	// TEMPLATE: AWSSDKPACKAGE = "acm" (and AWSSDKPACKAGEtypes = acmtypes)
	// Find your service's package at: github.com/aws/aws-sdk-go-v2/service/
	"github.com/aws/aws-sdk-go-v2/service/acm"
	acmtypes "github.com/aws/aws-sdk-go-v2/service/acm/types"

	// Standard project imports - same for every service. awsv2 is the only
	// sanctioned way to build a client.
	"github.com/mattmillerai/awtest/cmd/awtest/awsv2"
	"github.com/mattmillerai/awtest/cmd/awtest/types"
	"github.com/mattmillerai/awtest/cmd/awtest/utils"
)

// TEMPLATE: var SERVICECalls -> var CertificateManagerCalls
// Convention: DISPLAYNAMECalls (PascalCase + "Calls")
var CertificateManagerCalls = []types.AWSService{
	{
		// TEMPLATE: Name = "AWSPREFIX:APIMETHOD"
		// Here: "acm:ListCertificates"
		Name: "acm:ListCertificates",

		// CallV2 receives the aws.Config carried in the context. Callers run it
		// through types.AWSService.Invoke, which normalises the error to
		// "<code>: <message>".
		CallV2: func(ctx context.Context, cfg aws.Config) (interface{}, error) {
			// TEMPLATE: var allResults []AWSSDKPACKAGEtypes.RESULTTYPE
			// Here: []acmtypes.CertificateSummary (v2 returns values, not pointers)
			var allCertificates []acmtypes.CertificateSummary

			for _, region := range types.RegionsFor(ctx) {
				// TEMPLATE: awsv2.NewRegionalClient(cfg, region, AWSSDKPACKAGE.NewFromConfig)
				// Here: acm.NewFromConfig is passed as a function value, not called.
				svc := awsv2.NewRegionalClient(cfg, region, acm.NewFromConfig)

				// TEMPLATE: svc.APIMETHOD(ctx, &AWSSDKPACKAGE.APIMETHODINPUT{})
				// Here: svc.ListCertificates(ctx, &acm.ListCertificatesInput{})
				// (use acm.NewListCertificatesPaginator when every page is wanted)
				output, err := svc.ListCertificates(ctx, &acm.ListCertificatesInput{})
				if err != nil {
					return nil, err
				}

				// TEMPLATE: output.RESPONSEFIELD
				// Here: output.CertificateSummaryList
				allCertificates = append(allCertificates, output.CertificateSummaryList...)
			}
			return allCertificates, nil
		},

		Process: func(output interface{}, err error, debug bool) []types.ScanResult {
			var results []types.ScanResult

			if err != nil {
				// TEMPLATE: utils.HandleAWSError(debug, "AWSPREFIX:APIMETHOD", err)
				utils.HandleAWSError(debug, "acm:ListCertificates", err)
				return []types.ScanResult{
					{
						// TEMPLATE: ServiceName = "DISPLAYNAME"
						ServiceName: "CertificateManager",
						MethodName:  "acm:ListCertificates",
						Error:       err,
						Timestamp:   time.Now(),
					},
				}
			}

			// TEMPLATE: output.([]AWSSDKPACKAGEtypes.RESULTTYPE)
			// Here: output.([]acmtypes.CertificateSummary)
			if certs, ok := output.([]acmtypes.CertificateSummary); ok {
				for _, cert := range certs {
					// Nil-safe access for pointer fields: aws.ToString
					// TEMPLATE: item.NAMEFIELD
					// Here: cert.DomainName
					domainName := aws.ToString(cert.DomainName)
					certArn := aws.ToString(cert.CertificateArn)

					results = append(results, types.ScanResult{
						ServiceName:  "CertificateManager",   // TEMPLATE: "DISPLAYNAME"
						MethodName:   "acm:ListCertificates", // TEMPLATE: "AWSPREFIX:APIMETHOD"
						ResourceType: "certificate",          // TEMPLATE: "RESOURCETYPE"
						ResourceName: domainName,
						Details:      map[string]interface{}{},
						Timestamp:    time.Now(),
					})

					// PrintResult outputs to console with colorized resource names
					utils.PrintResult(debug, "", "acm:ListCertificates",
						fmt.Sprintf("Certificate: %s (ARN: %s)", utils.ColorizeItem(domainName), certArn), nil)
				}
			}
			return results
		},

		ModuleName: types.DefaultModuleName,
	},
}
